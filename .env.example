# Copy this file to .env and fill in real values. Do not commit .env.

# ── Public domain (Caddy TLS, docker-compose.yml only) ──
# Bare hostname, no scheme. Caddy fetches a Let's Encrypt cert for it.
DOMAIN=

# ── Database ─────────────────────────────────
DB_NAME=recall
DB_USER=postgres
DB_PASSWORD=
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/recall

# ── JWT ──────────────────────────────────────
JWT_SECRET=
JWT_EXPIRATION=3600000

# ── CORS ─────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ── Google OAuth2 ────────────────────────────
GOOGLE_CLIENT_ID=

# ── Mail (email OTP) ─────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── LiveKit (audio/video calls) ──────────────
# Create a project at https://cloud.livekit.io and paste its values here.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_MINUTES=60

# ── Deepgram (call transcription) ────────────
DEEPGRAM_API_KEY=

# ── Embeddings ───────────────────────────────
# all-MiniLM-L6-v2 runs locally in-process (langchain4j); no API key required.

# ── Groq (LLM for decision extraction + RAG) ─
# OpenAI-compatible API. Get a key at https://console.groq.com
# See current model ids: https://console.groq.com/docs/models
#   GROQ_MODEL      — RAG answers and conflict classification (the hard call)
#   GROQ_FAST_MODEL — the per-message "is this a decision?" gate and titles
# Both run at temperature 0; the classifications are exact-match single tokens.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# ── Frontend ─────────────────────────────────
VITE_API_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=
# Fallback only — the backend returns the URL alongside each token.
VITE_LIVEKIT_URL=
