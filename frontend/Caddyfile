# One server: TLS, the SPA's static files, and the API/WS proxy.
#
# This used to be Caddy in front of an nginx that served the files and did the
# proxying — two hops for one origin. Caddy does both, so nginx.conf and its
# container are gone.
#
# {$DOMAIN::80} means "the domain, or plain :80 if DOMAIN is unset", which is
# what docker-compose.local.yml runs — no domain, no certificate, no TLS.
{$DOMAIN::80} {
	encode gzip

	# Call recordings are uploaded whole to /api/channels/*/recording. Caddy's
	# default is unlimited, but keep it pinned to Spring's own multipart limit
	# so an oversized upload is refused here rather than deep in the app.
	request_body {
		max_size 100MB
	}

	# `handle` blocks, not bare directives: Caddy sorts bare directives into its
	# own order, in which try_files runs BEFORE reverse_proxy — so /api/channels
	# got rewritten to /index.html and the SPA was served with a 200 instead of
	# reaching the backend. handle blocks are mutually exclusive and run in the
	# order written. Verified by curling /api with the backend down: 502, not 200.
	@backend path /api/* /auth/* /ws/*
	handle @backend {
		# Caddy proxies WebSocket upgrades natively — no extra header block.
		reverse_proxy app:8080
	}

	handle {
		root * /srv

		# index.html names the current asset hashes, so a stale copy pins the
		# browser to a previous build. no-cache means revalidate before use,
		# not don't-store — the ETag keeps it a cheap 304.
		@index path /index.html /
		header @index Cache-Control "no-cache"

		# Everything under /assets/ is content-addressed by Vite: a change to
		# the file changes its name, so the old name is never reused.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# SPA routing: an unknown path is a client route, not a 404.
		try_files {path} /index.html
		file_server
	}
}
